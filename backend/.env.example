# Copy to backend/.env and adjust. All values shown are the defaults.

# --- LLM -------------------------------------------------------------
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
# Use llama3.2:1b on CPU-only servers
LLM_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=30m
WARM_UP_ON_START=true
TEMPERATURE=0.7
NUM_PREDICT=160
# CPU threads for the model; 0 = automatic (half the cores)
LLM_NUM_THREAD=0

# --- Context window (docs/ARCHITECTURE.md §4) -------------------------
NUM_CTX=4096
HISTORY_TOKEN_BUDGET=3000
MAX_USER_CHARS=500
TRIM_CHUNK_TURNS=6

# --- TTS -------------------------------------------------------------
# piper, kokoro, or both (the first one's voice is the default)
TTS_ENGINE=piper
KOKORO_DEFAULT_VOICE=bf_emma
KOKORO_SPEED=1.0
DEFAULT_VOICE=uk-south
# The voices offered, in picker order (five regional English accents). [] = every installed voice.
VOICES=["uk-south","uk-north","uk-midlands","uk-east","uk-west"]
TTS_LENGTH_SCALE=1.05
# CPU threads for Piper; 0 = automatic (a third of the cores)
TTS_THREADS=0

# --- Voice input (push-to-talk, local Whisper) --------------------------
# "none" switches it off
STT_ENGINE=whisper
STT_MODEL=base.en
# CPU threads for Whisper; 0 = automatic (a third of the cores)
STT_THREADS=0
STT_MAX_SECONDS=30

# --- HTTP ------------------------------------------------------------
CORS_ORIGINS=["http://localhost:4200"]
LOG_LEVEL=INFO
