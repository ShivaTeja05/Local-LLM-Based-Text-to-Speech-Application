# Copy to backend/.env and adjust. All values shown are the defaults.

# --- LLM -------------------------------------------------------------
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
# Use llama3.2:1b on CPU-only servers
LLM_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=30m
WARM_UP_ON_START=true
TEMPERATURE=0.7
NUM_PREDICT=160

# --- Context window (docs/ARCHITECTURE.md §4) -------------------------
NUM_CTX=4096
HISTORY_TOKEN_BUDGET=3000
MAX_USER_CHARS=500
TRIM_CHUNK_TURNS=6

# --- TTS -------------------------------------------------------------
TTS_ENGINE=piper
DEFAULT_VOICE=en_GB-cori-high
TTS_LENGTH_SCALE=1.05

# --- HTTP ------------------------------------------------------------
CORS_ORIGINS=["http://localhost:4200"]
LOG_LEVEL=INFO
